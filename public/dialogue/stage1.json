    {
      "id": "scene_08_why_attacking",
      "title": "Scene 08 — Why Is Everything Attacking Us?",
      "trigger": "extended_hostility_quiet",
      "enabled": true,
      "category": "essential",
      "priority": 2,
      "persistenceScope": "once_per_run",
      "retention": "run_deferred",
      "resumable": true,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "always",
      "needsHeroVariantReview": false,
      "variants": {
        "default": [
          {
            "id": "s08_01",
            "speaker": "commander",
            "text": "Is everything on this planet trying to kill us?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_08_why_attacking/s08_01.wav",
            "durationSec": 2.71,
            "direction": "Tired, exasperated question"
          },
          {
            "id": "s08_02",
            "speaker": "overseer",
            "text": "The indigenous organisms represent a significant threat.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_08_why_attacking/s08_02.wav",
            "durationSec": 4.25,
            "direction": "Formal, guarded"
          },
          {
            "id": "s08_03",
            "speaker": "doctor",
            "text": "That's an observation, not an explanation.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_08_why_attacking/s08_03.wav",
            "durationSec": 3.12,
            "direction": "Pointed, analytical pushback"
          },
          {
            "id": "s08_04",
            "speaker": "overseer",
            "text": "Their behavior is consistent with hostile biological activity.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_08_why_attacking/s08_04.wav",
            "durationSec": 4.61,
