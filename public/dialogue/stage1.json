  "conversations": [
    {
      "id": "scene_01_first_steps",
      "title": "Scene 01 — First Steps",
      "trigger": "left_crash_site",
      "enabled": true,
      "category": "essential",
      "priority": 1,
      "persistenceScope": "once_per_run",
      "retention": "stage_deferred",
      "resumable": true,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "before_boss_spawned",
      "needsHeroVariantReview": false,
      "variants": {
        "commander": [
          {
            "id": "s01_cmd_01",
            "speaker": "doctor",
            "text": "Mander, you hear me?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_01.wav",
            "durationSec": 1.87,
            "direction": "Warm, casual radio check with a hint of teasing familiarity"
          },
          {
            "id": "s01_cmd_02",
            "speaker": "commander",
            "text": "Yes, ma'am. Although I was enjoying the silence.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_02.wav",
            "durationSec": 3.07,
            "direction": "Relaxed, dryly humorous military confidence"
          },
          {
            "id": "s01_cmd_03",
            "speaker": "doctor",
            "text": "Cute. Try not to die. We're running low on medical supplies, and we still have people out there to find.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_03.wav",
            "durationSec": 5.83,
            "direction": "Quick playful comeback shifting into grounded urgency"
          },
          {
            "id": "s01_cmd_04",
            "speaker": "commander",
            "text": "Any sign of them?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_04.wav",
            "durationSec": 1.87,
            "direction": "Focused, grounded field check"
          },
          {
            "id": "s01_cmd_05",
            "speaker": "doctor",
            "text": "Nothing yet. And the ship's still missing parts. We're not going anywhere until we find what we need.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_05.wav",
            "durationSec": 5.98,
            "direction": "Analytical, matter-of-fact, slightly weary"
          },
          {
            "id": "s01_cmd_06",
            "speaker": "overseer",
            "text": "I strongly advise against exploring without a comprehensive environmental assessment.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_06.wav",
            "durationSec": 5.71,
            "direction": "Composed, formal, measured synthetic precision"
          },
          {
            "id": "s01_cmd_07",
            "speaker": "commander",
            "text": "Great. The floating Christmas ornament has concerns.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_07.wav",
            "durationSec": 3.43,
            "direction": "Deadpan sarcasm"
          },
          {
            "id": "s01_cmd_08",
            "speaker": "overseer",
            "text": "I am beginning to understand why your species has such a high mortality rate.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_cmd_08.wav",
            "durationSec": 5.14,
            "direction": "Quietly biting, ultra-polite dry sarcasm"
          }
        ],
        "doctor": [
          {
            "id": "s01_doc_01",
            "speaker": "commander",
            "text": "Doc, how's it looking out there?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_doc_01.wav",
            "durationSec": 1.87,
            "direction": "Authoritative, protective radio check"
          },
          {
            "id": "s01_doc_02",
            "speaker": "doctor",
            "text": "Cold, hostile, and biologically fascinating. So, basically, my dream vacation.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_doc_02.wav",
            "durationSec": 6.31,
            "direction": "Bright, amused, slightly chaotic scientific enthusiasm"
          },
          {
            "id": "s01_doc_03",
            "speaker": "commander",
            "text": "Keep your eyes open for our people. Any sign of them, you call it in.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_doc_03.wav",
            "durationSec": 4.13,
            "direction": "Steady, decisive, caring field command"
          },
          {
            "id": "s01_doc_04",
            "speaker": "doctor",
            "text": "Mander, I know. Missing crew, missing ship parts, questionable survival odds. I've got the list.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_doc_04.wav",
            "durationSec": 6.94,
            "direction": "Fondly exasperated, brisk and capable"
          },
          {
            "id": "s01_doc_05",
            "speaker": "overseer",
            "text": "Your enthusiasm is concerning.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_doc_05.wav",
            "durationSec": 3.05,
            "direction": "Cool, clinical disapproval"
          },
          {
            "id": "s01_doc_06",
            "speaker": "doctor",
            "text": "Oh, shut up. I literally brought you back to life.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_01_first_steps/s01_doc_06.wav",
            "durationSec": 3.77,
            "direction": "Breezy, unapologetic snap-back with dry humor"
          }
        ]
      },
      "onComplete": {
        "codexEntryId": "lore_stage1_crash_objectives",
        "codexTitle": "Crash Perimeter — Initial Objectives",
        "codexSummary": "With the spacecraft crippled in Sector 1's crater, the survivors must locate missing crewmates, salvage replacement parts, and stabilize the nearby Overseer artifact."
      }
    },
    {
      "id": "scene_02_planet_waking_up",
      "title": "Scene 02 — The Planet Is Waking Up",
      "trigger": "flora_discovered",
      "enabled": true,
      "category": "essential",
      "priority": 1,
      "persistenceScope": "once_per_run",
      "retention": "stage_deferred",
      "resumable": true,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "same_stage",
      "needsHeroVariantReview": false,
      "variants": {
        "default": [
          {
            "id": "s02_01",
            "speaker": "doctor",
            "text": "Wait. Those organisms... they're actually growing?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_02_planet_waking_up/s02_01.wav",
            "durationSec": 3.62,
            "direction": "Sudden scientific astonishment"
          },
          {
            "id": "s02_02",
            "speaker": "overseer",
            "text": "That should not be possible. This region remained frozen for an extensive period.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_02_planet_waking_up/s02_02.wav",
            "durationSec": 6.29,
            "direction": "Measured surprise restrained beneath formal composure"
          },
          {
            "id": "s02_03",
            "speaker": "commander",
            "text": "Well, somebody forgot to tell the plants.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_02_planet_waking_up/s02_03.wav",
            "durationSec": 2.59,
            "direction": "Dry, grounded quip"
          },
          {
            "id": "s02_04",
            "speaker": "doctor",
            "text": "No, seriously. Something changed here. And I want to know what.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_02_planet_waking_up/s02_04.wav",
            "durationSec": 4.7,
            "direction": "Intrigued, insistent analytical focus"
          },
          {
            "id": "s02_05",
            "speaker": "overseer",
            "text": "Curiosity without caution is frequently fatal.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_02_planet_waking_up/s02_05.wav",
            "durationSec": 3.89,
            "direction": "Calm, solemn warning"
          },
          {
            "id": "s02_06",
            "speaker": "doctor",
            "text": "And being mysterious instead of helpful is frequently annoying.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_02_planet_waking_up/s02_06.wav",
            "durationSec": 4.15,
            "direction": "Sharp, witty retort"
          }
        ]
      }
    },
    {
      "id": "scene_03_first_hostile_encounter",
      "title": "Scene 03 — First Hostile Encounter",
      "trigger": "first_hostile_encounter",
      "enabled": true,
      "category": "contextual",
      "priority": 1,
      "persistenceScope": "once_per_run",
      "retention": "stage_immediate",
      "ttlSec": 4,
      "resumable": false,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "before_boss_spawned",
      "needsHeroVariantReview": true,
      "variants": {
        "default": [
          {
            "id": "s03_01",
            "speaker": "commander",
            "text": "Contact! We've got movement!",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_03_first_hostile_encounter/s03_01.wav",
            "durationSec": 2.21,
            "direction": "Sharp combat alert"
          },
          {
            "id": "s03_02",
            "speaker": "overseer",
            "text": "Hostile organism detected. Exercise extreme caution.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_03_first_hostile_encounter/s03_02.wav",
            "durationSec": 5.54,
            "direction": "Crisp tactical warning"
          },
          {
            "id": "s03_03",
            "speaker": "doctor",
            "text": "Wait, I want to see how it reacts—",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_03_first_hostile_encounter/s03_03.wav",
            "durationSec": 2.3,
            "direction": "Eager, reckless curiosity cut short"
          },
          {
            "id": "s03_04",
            "speaker": "commander",
            "text": "Doc, it's trying to kill me!",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_03_first_hostile_encounter/s03_04.wav",
            "durationSec": 1.87,
            "direction": "Urgent, incredulous combat shout"
          },
          {
            "id": "s03_05",
            "speaker": "doctor",
            "text": "Well, that's one reaction.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_03_first_hostile_encounter/s03_05.wav",
            "durationSec": 2.54,
            "direction": "Unfazed, dryly amused"
          }
        ]
      }
    },
    {
      "id": "scene_04_something_in_the_water",
      "title": "Scene 04 — Something In The Water",
      "trigger": "water_discovered",
      "enabled": true,
      "category": "contextual",
      "priority": 2,
      "persistenceScope": "once_per_run",
      "retention": "stage_deferred",
      "resumable": true,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "same_stage",
      "needsHeroVariantReview": true,
      "variants": {
        "default": [
          {
            "id": "s04_01",
            "speaker": "doctor",
            "text": "Interesting. There's liquid water here. I want a sample.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_04_something_in_the_water/s04_01.wav",
            "durationSec": 4.03,
            "direction": "Curious, fascinated"
          },
          {
            "id": "s04_02",
            "speaker": "commander",
            "text": "Can we make sure it doesn't dissolve my boots first?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_04_something_in_the_water/s04_02.wav",
            "durationSec": 2.81,
            "direction": "Pragmatic, dry humor"
          },
          {
            "id": "s04_03",
            "speaker": "overseer",
            "text": "Its composition has not been established.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_04_something_in_the_water/s04_03.wav",
            "durationSec": 3.41,
            "direction": "Clinical neutrality"
          },
          {
            "id": "s04_04",
            "speaker": "doctor",
            "text": "Finally. Something we agree on.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_04_something_in_the_water/s04_04.wav",
            "durationSec": 2.59,
            "direction": "Playful mock-celebration"
          },
          {
            "id": "s04_05",
            "speaker": "commander",
            "text": "You two agreeing on something is somehow more disturbing than the water.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_04_something_in_the_water/s04_05.wav",
            "durationSec": 5.06,
            "direction": "Wryly deadpan"
          }
        ]
      }
    },
    {
      "id": "scene_05_biological_sacs",
      "title": "Scene 05 — The Biological Sacs",
      "trigger": "first_pod_opened",
      "enabled": true,
      "category": "contextual",
      "priority": 2,
      "persistenceScope": "once_per_run",
      "retention": "stage_deferred",
      "resumable": false,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "same_stage",
      "needsHeroVariantReview": true,
      "variants": {
        "default": [
          {
            "id": "s05_01",
            "speaker": "doctor",
            "text": "You just ripped that thing open?!",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_05_biological_sacs/s05_01.wav",
            "durationSec": 1.92,
            "direction": "Appalled, amused shock"
          },
          {
            "id": "s05_02",
            "speaker": "commander",
            "text": "There was something inside.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_05_biological_sacs/s05_02.wav",
            "durationSec": 1.87,
            "direction": "Blunt, unapologetic"
          },
          {
            "id": "s05_03",
            "speaker": "doctor",
            "text": "That's not an answer! What if it was an egg?",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_05_biological_sacs/s05_03.wav",
            "durationSec": 3.07,
            "direction": "Expressive, half-scolding disbelief"
          },
          {
            "id": "s05_04",
            "speaker": "commander",
            "text": "Then congratulations. We just became parents.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_05_biological_sacs/s05_04.wav",
            "durationSec": 3.46,
            "direction": "Deadpan sarcasm"
          },
          {
            "id": "s05_05",
            "speaker": "overseer",
            "text": "I strongly recommend against reproducing under these circumstances.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_05_biological_sacs/s05_05.wav",
            "durationSec": 4.82,
            "direction": "Completely literal, bone-dry delivery"
          },
          {
            "id": "s05_06",
            "speaker": "doctor",
            "text": "Oh my God.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_05_biological_sacs/s05_06.wav",
            "durationSec": 1.87,
            "direction": "Exasperated laugh-sigh"
          }
        ]
      }
    },
    {
      "id": "scene_06_first_enhancement",
      "title": "Scene 06 — The First Enhancement",
      "trigger": "first_enhancement_completed",
      "enabled": true,
      "category": "contextual",
      "priority": 2,
      "persistenceScope": "once_per_run",
      "retention": "stage_deferred",
      "resumable": true,
      "prerequisiteRule": "stage1_campaign_only",
      "relevanceRule": "same_stage",
      "needsHeroVariantReview": true,
      "variants": {
        "default": [
          {
            "id": "s06_01",
            "speaker": "doctor",
            "text": "Okay, that was interesting. Something just altered your equipment's output.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_06_first_enhancement/s06_01.wav",
            "durationSec": 4.42,
            "direction": "Alert, fascinated analysis"
          },
          {
            "id": "s06_02",
            "speaker": "commander",
            "text": "I'm choosing to interpret that as a good thing.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_06_first_enhancement/s06_02.wav",
            "durationSec": 2.74,
            "direction": "Calm, wry optimism"
          },
          {
            "id": "s06_03",
            "speaker": "overseer",
            "text": "You are utilizing technology whose operating principles you do not understand.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_06_first_enhancement/s06_03.wav",
            "durationSec": 5.5,
            "direction": "Stiffly disapproving"
          },
          {
            "id": "s06_04",
            "speaker": "doctor",
            "text": "That's literally how half of science starts.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_06_first_enhancement/s06_04.wav",
            "durationSec": 2.45,
            "direction": "Cheeky, cheerful"
          },
          {
            "id": "s06_05",
            "speaker": "overseer",
            "text": "That is not a reassuring statement.",
            "audioUrl": "/assets/audio/dialogue/stage1/scene_06_first_enhancement/s06_05.wav",
            "durationSec": 3.14,
            "direction": "Dry, exhausted precision"
          }
        ]
      }
    },
    {
      "id": "scene_07_first_artifact_clue",
      "title": "Scene 07 — The First Artifact Clue",
      "trigger": "artifact_discovered",
      "enabled": true,
      "category": "essential",
      "priority": 1,
      "persistenceScope": "once_per_run",
